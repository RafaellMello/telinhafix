{
  "name": "screenbunny",
  "version": "1.0.0",
  "description": "App local para compartilhamento de tela entre amigos, estilo Discord",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:native": "dotnet publish native-audio -c Release && node -e \"require('fs').cpSync('native-audio/bin/Release/net9.0-windows10.0.19041.0/win-x64/publish/ScreenBunnyAudioHelper.exe','native/ScreenBunnyAudioHelper.exe')\"",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.screenbunny.app",
    "productName": "ScreenBunny",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/ScreenBunnyAudioHelper.exe",
        "to": "native/ScreenBunnyAudioHelper.exe"
      }
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "ScreenBunny.exe"
    }
  }
}
